# Frontend public variables (Vercel). VITE_* values are bundled into the browser.
# Use the Supabase URL and anon/publishable key for the staging project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_APP_ENV=staging
# Demo seed is opt-in and must remain disabled in staging/production.
VITE_ENABLE_DEMO_SEED=false

# Backend / Supabase Edge Functions only. Configure these as Supabase secrets,
# never as VITE_* variables or Vercel client environment variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Cloudflare R2 backend-only variables. R2 is not required for staging.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://your-r2-public-base-url
