# Frontend public variables (Vercel). VITE_* values are bundled into the browser.
# Use the Supabase URL and anon/publishable key for the staging project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_APP_ENV=staging
# Demo seed is opt-in and must remain disabled in staging/production.
VITE_ENABLE_DEMO_SEED=false
# Public origin used ONLY to build printable/shareable deep links (asset QR
# codes). NOT secret. Must be a bare origin: http(s)://host[:port], no path,
# query or hash. Prefer https:// in staging/production; http:// is only
# accepted for localhost/127.0.0.1 in local development. If unset or
# invalid, the app falls back to window.location.origin (so localhost keeps
# working with zero configuration) and warns in the dev console.
VITE_PUBLIC_APP_URL=https://your-public-domain.example.com

# Backend / Supabase Edge Functions only. Configure these as Supabase secrets,
# never as VITE_* variables or Vercel client environment variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side origin used ONLY by send-organization-invitation /
# admin-create-organization to build the invitation/magic-link redirect URL
# (<PUBLIC_APP_URL>/invitations/accept?invitation=<uuid>). NOT the same
# variable as VITE_PUBLIC_APP_URL above — that one is a frontend bundle
# value with no business deciding a backend redirect target. Must be a bare
# origin (no path/query/hash); https:// required outside local development;
# http:// only for localhost/127.0.0.1. Missing or invalid fails closed
# (the Edge Function returns an error) — it never falls back to localhost
# or trusts the request's Origin/Referer header. See docs/USER_INVITATIONS.md.
PUBLIC_APP_URL=https://your-public-domain.example.com

# Cloudflare R2 — backend-only (Edge Function `asset-files`, Fase 1 · Punto 7).
# Required for asset file uploads/downloads (photos/documents). The bucket
# is fully PRIVATE: there is no public base URL — every download goes
# through a short-lived signed URL generated on demand by asset-files, and
# no object URL is ever persisted in the database. Missing/invalid values
# fail closed (getR2Config in supabase/functions/_shared/r2.ts) — the
# function returns an error, it never falls back to a default bucket/account.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
