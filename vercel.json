{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feature/romax-r2e1-material-catalog-foundation": false,
      "feature/romax-r2e1-2-unit-normalization": false,
      "feature/romax-r2e1-5-material-catalog-ui": false,
      "docs/romax-r2e2-commercial-pricing-design": false,
      "feature/romax-r2e2-1-pricing-access-security": false,
      "productization/mvp": false,
      "fix/romax-inline-material-details-20261127": false,
      "feature/romax-r3-gmail-oauth": false,
      "feature/romax-r3-gmail-preview": false
    }
  },
  "headers": [
    {
      "source": "/gmail/callback",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
